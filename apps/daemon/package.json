{
  "name": "@agent-dock/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "predev": "node scripts/build-windows-job-host.mjs",
    "dev": "tsx watch src/index.ts",
    "prestart": "node scripts/build-windows-job-host.mjs",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:live-providers": "tsx src/live-smoke/cli.ts"
  },
  "dependencies": {
    "@agent-dock/agent-runtime": "workspace:*",
    "@agent-dock/shared": "workspace:*",
    "@fastify/rate-limit": "11.2.0",
    "ajv": "^8.20.0",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@agent-dock/client": "workspace:*",
    "@types/node": "^22.10.5",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  }
}
