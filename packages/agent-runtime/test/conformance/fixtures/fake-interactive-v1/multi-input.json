{
  "schema": "agent-dock/provider-fixture@1",
  "schemaSet": "agent-dock-provider-fixture-v1",
  "fixtureSet": "fake-interactive-v1",
  "id": "fake-interactive-multi-input",
  "protocol": "v2",
  "provider": { "id": "claude", "implementation": "fake", "version": "fake-interactive-v1" },
  "transport": { "id": "fake-interactive", "version": "1" },
  "scenario": "multi-input",
  "covers": ["multi-input", "command-correlation"],
  "startup": { "started": "resolve", "acceptedWork": "accepted" },
  "nativeInput": [{ "prompt": "<redacted:prompt>" }],
  "nativeOutput": [
    {
      "phase": "startup",
      "channel": "events",
      "value": {
        "type": "session.started",
        "provider": "claude",
        "transport": "fake-interactive",
        "selection": "<fixture-selection>"
      }
    },
    {
      "phase": "startup",
      "channel": "events",
      "value": { "type": "turn.started", "turnId": "<turn-id>" }
    },
    {
      "phase": "startup",
      "channel": "events",
      "value": { "type": "turn.completed", "turnId": "<turn-id>" }
    },
    {
      "phase": "startup",
      "channel": "events",
      "value": { "type": "session.status", "status": "idle" }
    },
    {
      "phase": "control:0",
      "channel": "events",
      "value": { "type": "session.status", "status": "active" }
    },
    {
      "phase": "control:0",
      "channel": "events",
      "value": { "type": "turn.started", "turnId": "<follow-up-turn-id>" }
    },
    {
      "phase": "control:0",
      "channel": "events",
      "value": { "type": "turn.completed", "turnId": "<follow-up-turn-id>" }
    },
    { "phase": "control:0", "channel": "events", "value": { "type": "session.completed" } }
  ],
  "controls": [
    {
      "operation": "send",
      "afterEvent": "turn.completed",
      "command": {
        "type": "input.follow_up",
        "commandId": "<command-id>",
        "sessionId": "<session-id>",
        "turnId": "<follow-up-turn-id>",
        "content": [{ "type": "text", "id": "<content-block-id>", "text": "<redacted:prompt>" }]
      }
    }
  ],
  "expectedNormalizedEvents": [
    {
      "type": "session.started",
      "provider": "claude",
      "transport": "fake-interactive",
      "selection": "<fixture-selection>"
    },
    { "type": "turn.started", "turnId": "<turn-id>" },
    { "type": "turn.completed", "turnId": "<turn-id>" },
    { "type": "session.status", "status": "idle" },
    { "type": "session.status", "status": "active" },
    { "type": "turn.started", "turnId": "<follow-up-turn-id>" },
    { "type": "turn.completed", "turnId": "<follow-up-turn-id>" },
    { "type": "session.completed" }
  ],
  "terminalState": {
    "type": "session.completed",
    "count": 1,
    "acceptedWork": "accepted",
    "workMayHaveStarted": true,
    "fallbackAllowed": false
  },
  "cleanup": { "closeCalls": 1, "forceCloseCalls": 0, "interactionResolutions": 0, "reaped": true }
}
