{
  "schema": "agent-dock/provider-fixture@1",
  "schemaSet": "agent-dock-provider-fixture-v1",
  "fixtureSet": "fake-interactive-v1",
  "id": "fake-interactive-cancellation",
  "protocol": "v2",
  "provider": { "id": "claude", "implementation": "fake", "version": "fake-interactive-v1" },
  "transport": { "id": "fake-interactive", "version": "1" },
  "scenario": "cancellation",
  "covers": ["cancellation", "request-cleanup"],
  "startup": { "started": "resolve", "acceptedWork": "accepted" },
  "nativeInput": [{ "prompt": "<redacted:prompt>" }],
  "nativeOutput": [
    {
      "phase": "startup",
      "channel": "events",
      "value": {
        "type": "session.started",
        "provider": "claude",
        "transport": "fake-interactive",
        "selection": "<fixture-selection>"
      }
    },
    {
      "phase": "startup",
      "channel": "events",
      "value": { "type": "turn.started", "turnId": "<turn-id>" }
    },
    {
      "phase": "startup",
      "channel": "events",
      "value": {
        "type": "question.requested",
        "turnId": "<turn-id>",
        "requestId": "<request-id>",
        "questions": [
          {
            "id": "<question-id>",
            "title": "Fixture question",
            "prompt": "<redacted:question>",
            "allowsFreeText": true
          }
        ],
        "deadlineAt": "<deadline>"
      }
    }
  ],
  "controls": [{ "operation": "close", "afterEvent": "question.requested" }],
  "expectedNormalizedEvents": [
    {
      "type": "session.started",
      "provider": "claude",
      "transport": "fake-interactive",
      "selection": "<fixture-selection>"
    },
    { "type": "turn.started", "turnId": "<turn-id>" },
    {
      "type": "question.requested",
      "turnId": "<turn-id>",
      "requestId": "<request-id>",
      "questions": [
        {
          "id": "<question-id>",
          "title": "Fixture question",
          "prompt": "<redacted:question>",
          "allowsFreeText": true
        }
      ],
      "deadlineAt": "<deadline>"
    },
    {
      "type": "question.cancelled",
      "turnId": "<turn-id>",
      "requestId": "<request-id>",
      "reason": "cancel"
    },
    { "type": "session.cancelled", "reason": "session closed" }
  ],
  "terminalState": {
    "type": "session.cancelled",
    "count": 1,
    "acceptedWork": "accepted",
    "workMayHaveStarted": true,
    "fallbackAllowed": false
  },
  "cleanup": { "closeCalls": 1, "forceCloseCalls": 0, "interactionResolutions": 1, "reaped": true }
}
