{
  "name": "@agent-dock/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node ../../apps/daemon/scripts/build-windows-job-host.mjs && vitest run",
    "test:conformance": "node ../../apps/daemon/scripts/build-windows-job-host.mjs && vitest run --maxWorkers=1 test/provider-conformance.test.ts test/fixture-safety.test.mjs test/claude-contract.test.ts test/codex-contract.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.251",
    "@anthropic-ai/sdk": "0.122.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@agent-dock/shared": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.251"
  }
}
