{
  "name": "@agent-dock/desktop",
  "version": "0.1.0",
  "description": "AgentDock desktop client: Electron + React demo for the AgentDock boilerplate",
  "author": "AgentDock contributors",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "electron-builder",
    "package:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@agent-dock/client": "workspace:*",
    "@agent-dock/shared": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^3.2.6"
  }
}
